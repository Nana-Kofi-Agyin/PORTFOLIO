# Server-side only. Set these in Vercel > Project > Settings > Environment Variables.
# Do not prefix them with VITE_ (that would expose them in the browser).
# In EmailJS, enable "Allow EmailJS API for non-browser applications" to use the private key.
# The contact form needs `vercel dev` locally, because /api/contact is a Vercel function.
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key

# Privacy-friendly analytics (optional, pick one):
# Option A: Plausible (cookieless)
# VITE_PLAUSIBLE_DOMAIN=yourdomain.com
# Option B: Vercel Web Analytics (enable in Vercel dashboard first)
# VITE_VERCEL_ANALYTICS=true
